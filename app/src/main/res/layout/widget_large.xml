<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/large_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_card" android:layoutDirection="rtl" android:orientation="vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="16dp">
    <LinearLayout android:id="@+id/large_top" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/widget_sun" android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/large_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#1E1B3A" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:text="@string/widget_title" />
        <TextView android:id="@+id/large_amount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#1E1B3A" android:textSize="30sp" android:fontFamily="sans-serif-black" android:text="—" />
        <TextView android:id="@+id/large_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textColor="#4A4520" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/large_week" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="10dp">
        <TextView android:id="@+id/large_week_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textColor="#1E1B3A" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
    <ProgressBar android:id="@+id/lweek_green" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp"
        android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_bar_green"
        android:visibility="visible" />
    <ProgressBar android:id="@+id/lweek_amber" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp"
        android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_bar_amber"
        android:visibility="gone" />
    <ProgressBar android:id="@+id/lweek_red" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp"
        android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_bar_red"
        android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/line1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/line1_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/wic_category" />
            <TextView android:id="@+id/line1_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:maxLines="1" android:ellipsize="end" android:textColor="#1E1B3A" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/line1_left" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#5E5A7A" android:textSize="12sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/line1_bar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp"
            android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_bar_ink" />
    </LinearLayout>
    <LinearLayout android:id="@+id/line2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/line2_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/wic_category" />
            <TextView android:id="@+id/line2_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:maxLines="1" android:ellipsize="end" android:textColor="#1E1B3A" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/line2_left" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#5E5A7A" android:textSize="12sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/line2_bar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp"
            android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_bar_ink" />
    </LinearLayout>
    <LinearLayout android:id="@+id/line3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/line3_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/wic_category" />
            <TextView android:id="@+id/line3_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:maxLines="1" android:ellipsize="end" android:textColor="#1E1B3A" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/line3_left" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#5E5A7A" android:textSize="12sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/line3_bar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp"
            android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_bar_ink" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <LinearLayout android:id="@+id/btn_add" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:background="@drawable/widget_btn_add" android:gravity="center" android:orientation="horizontal">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/wic_add" />
            <TextView android:id="@+id/btn_add_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:textColor="#1E1B3A" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:text="مصروف" />
        </LinearLayout>
        <TextView android:id="@+id/btn_sort" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_plain" android:gravity="center"
            android:textColor="#1E1B3A" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:text="صنّف" />
    </LinearLayout>
</LinearLayout>
